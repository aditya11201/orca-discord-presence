{
  "manifestVersion": 2,
  "execution": "trusted-worker",
  "id": "discord-presence",
  "name": "Discord Presence",
  "version": "0.2.0",
  "description": "Publishes what your Orca agent fleet is doing to your Discord status via local Rich Presence IPC.",
  "author": { "name": "aditya11201", "url": "https://github.com/aditya11201" },
  "repository": "https://github.com/aditya11201/orca-discord-presence",
  "engines": { "orca": ">=1.4.246" },
  "pluginApi": 1,
  "main": "dist/main.mjs",
  "contributes": {
    "commands": [
      { "id": "presence.toggle", "title": "Discord Presence: Toggle", "when": "global" },
      {
        "id": "presence.privacy",
        "title": "Discord Presence: Cycle Privacy Level",
        "when": "global"
      },
      { "id": "presence.header", "title": "Discord Presence: Set Header", "when": "global" },
      {
        "id": "presence.logo",
        "title": "Discord Presence: Toggle Agent Logo",
        "when": "global"
      },
      { "id": "presence.reconnect", "title": "Discord Presence: Reconnect", "when": "global" },
      {
        "id": "presence.status",
        "title": "Discord Presence: Show Connection Status",
        "when": "global"
      }
    ],
    "events": [
      { "on": "workspace.created" },
      { "on": "workspace.removed" },
      { "on": "agent.status.changed" }
    ]
  },
  "capabilities": [
    { "kind": "workspace:read" },
    { "kind": "agent:read" },
    { "kind": "storage:own" },
    { "kind": "settings:own" },
    { "kind": "notifications:show" }
  ]
}
